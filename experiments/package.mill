package build.experiments

import mill.*, scalalib.*, publish.*
import contrib.jmh.JmhModule

// mill benchmark.runJmh vecxt.benchmark.AndBooleanBenchmark -jvmArgs --add-modules=jdk.incubator.vector -rf json

object `package` extends ScalaModule:
  // def enableBsp = false
  def scalaVersion = build.vecxt.jvm.scalaVersion
  override def compileResources = Task {
    super.compileResources() ++ resources()
  }
  def scalacOptions = Seq("-Xmax-inlines:10000")
  override def forkArgs = super.forkArgs() ++ build.vecIncubatorFlag
  // override def mainClass = Some("mnist")

  override def moduleDeps = Seq(build.vecxt.jvm, build.vecxtensions.jvm, build.vecxt_re.jvm, build.vecxt_io.jvm)
  override def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"com.lihaoyi::os-lib::0.10.4",
    mvn"io.github.quafadas::scautable::0.0.35",
    mvn"io.github.quafadas::dedav4s::0.10.5",
    mvn"org.apache.logging.log4j:log4j-core:2.24.3" // Required by Apache POI for Excel
  )

  // ---------------------------------------------------------------------------
  // This module has no tests of its own. It is the audited *subject*: cheatsheet.
  // scala is the model of user code that C6a scans and C9 measures, and Kernel.
  // scala is the bytecode-cost probe. Everything that checks it now lives in
  // `bytecodeAudit`:
  //
  //   ./mill bytecodeAudit.test
  //
  //   - `bytecodeSizes` / `bytecodeCheck` and their hand-rolled class file reader
  //     are superseded by out/bytecode-audit/method-sizes.csv (same columns plus
  //     annotations, loop and audited scope), checked against thresholds read off
  //     the JVM rather than hardcoded. The reader is shared by the checks and
  //     their fixtures now, which a build file cannot be — and two copies of a
  //     class file parser do not stay in agreement.
  //   - `specializationFailure.test.scala` is check C6a.
  //   - `specialisation.test.scala`, the runtime sweep, moved with it: it is C6a's
  //     other half rather than a separate concern, since a generic *allocation*
  //     through `ClassTag[A]` is invisible to bytecode.
  // ---------------------------------------------------------------------------
end `package`

